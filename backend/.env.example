PROJECT_NAME="Menu Digital Restaurante"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menu_digital_db"
HOST="0.0.0.0"
PORT=8000

# --- Seguridad / Autenticacion (JWT) ---
SECRET_KEY="cambia-esta-clave-por-una-generada-de-forma-segura"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Datos de prueba (seed) ---
# Si es true, al iniciar el servidor se insertan datos de prueba
# (platillos y un usuario admin inicial) SOLO si las tablas estan vacias.
# Los clientes del restaurante nunca inician sesion, por eso no hay un
# usuario "cliente" de prueba: el resto de cuentas admin se crean con
# POST /api/auth/registrar.
SEED_DATA=true
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123"
